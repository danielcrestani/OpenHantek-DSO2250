<RCC>
    <qresource prefix="/style">
        <file alias="arrow-up.png">style/arrow-up@2x.png</file>
        <file alias="arrow-down.png">style/arrow-down@2x.png</file>
        <file alias="arrow-up-disabled.png">style/arrow-up-disabled@2x.png</file>
        <file alias="arrow-down-disabled.png">style/arrow-down-disabled@2x.png</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="psg9080.png">icons/psg9080.png</file>
        <file alias="openhantek-bode.png">icons/openhantek-bode.png</file>
    </qresource>
</RCC>
